`define CPM6_ADDR_N  16
`define CPM6_ADDR_SZ 32
`define CPM6_DATA_SZ 88

// Attribute addresses
//

`define CPM6__BOT_CHIPPIPE_MODE    32'h00000000
`define CPM6__BOT_CHIPPIPE_MODE_SZ 48

