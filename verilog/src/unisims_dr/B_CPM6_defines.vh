`define CPM6__CONTROLLER_0_CXL_MODE_SZ 24

`define CPM6__CONTROLLER_0_IDE_MODE    32'h00000003
`define CPM6__CONTROLLER_0_IDE_MODE_SZ 24

`define CPM6__CONTROLLER_0_LINK_SPEED    32'h00000004
`define CPM6__CONTROLLER_0_LINK_SPEED_SZ 32

`define CPM6__CONTROLLER_0_LINK_WIDTH    32'h00000005
`define CPM6__CONTROLLER_0_LINK_WIDTH_SZ 16

`define CPM6__CONTROLLER_0_TLP_BYPASS_MODE    32'h00000006
`define CPM6__CONTROLLER_0_TLP_BYPASS_MODE_SZ 24

`define CPM6__CONTROLLER_1_CXL_MODE    32'h00000007
`define CPM6__CONTROLLER_1_CXL_MODE_SZ 24

`define CPM6__CONTROLLER_1_IDE_MODE    32'h00000008
`define CPM6__CONTROLLER_1_IDE_MODE_SZ 24

`define CPM6__CONTROLLER_1_LINK_SPEED    32'h00000009
`define CPM6__CONTROLLER_1_LINK_SPEED_SZ 32

`define CPM6__CONTROLLER_1_LINK_WIDTH    32'h0000000a
