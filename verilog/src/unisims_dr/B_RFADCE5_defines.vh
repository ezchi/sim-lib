// BLH dynamic attribute configuration look-up table addresses
//

`ifdef B_RFADCE5_DEFINES_VH
`else
`define B_RFADCE5_DEFINES_VH

// Look-up table parameters
//

`define RFADCE5_ADDR_N  15
`define RFADCE5_ADDR_SZ 32
`define RFADCE5_DATA_SZ 80

// Attribute addresses
//

`define RFADCE5__OPT_ANALOG    32'h00000000
`define RFADCE5__OPT_ANALOG_SZ 16

`define RFADCE5__SIM_DEVICE    32'h00000001
`define RFADCE5__SIM_DEVICE_SZ 80

`define RFADCE5__XPA_ACTIVE_DUTYCYCLE    32'h00000002
`define RFADCE5__XPA_ACTIVE_DUTYCYCLE_SZ 7

`define RFADCE5__XPA_CHANNELIZER_ENABLE    32'h00000003
`define RFADCE5__XPA_CHANNELIZER_ENABLE_SZ 2

`define RFADCE5__XPA_CHANNELS_PER_TILE    32'h00000004
`define RFADCE5__XPA_CHANNELS_PER_TILE_SZ 3

`define RFADCE5__XPA_CLOCK_SOURCE    32'h00000005
`define RFADCE5__XPA_CLOCK_SOURCE_SZ 2

`define RFADCE5__XPA_DATAPATH_MODE    32'h00000006
`define RFADCE5__XPA_DATAPATH_MODE_SZ 2

`define RFADCE5__XPA_DECIMATION    32'h00000007
`define RFADCE5__XPA_DECIMATION_SZ 4

`define RFADCE5__XPA_MIXING    32'h00000008
`define RFADCE5__XPA_MIXING_SZ 2

`define RFADCE5__XPA_NUMBER_OF_DDC    32'h00000009
`define RFADCE5__XPA_NUMBER_OF_DDC_SZ 4

`define RFADCE5__XPA_PFIR_CHANNELIZER_LOCATION    32'h0000000a
`define RFADCE5__XPA_PFIR_CHANNELIZER_LOCATION_SZ 1

`define RFADCE5__XPA_PFIR_TAPS    32'h0000000b
`define RFADCE5__XPA_PFIR_TAPS_SZ 7

`define RFADCE5__XPA_QMC_TAPS    32'h0000000c
`define RFADCE5__XPA_QMC_TAPS_SZ 7

`define RFADCE5__XPA_SAMPLE_RATE    32'h0000000d
`define RFADCE5__XPA_SAMPLE_RATE_SZ 15

`define RFADCE5__XPA_SPARE    32'h0000000e
`define RFADCE5__XPA_SPARE_SZ 16

`endif  // B_RFADCE5_DEFINES_VH