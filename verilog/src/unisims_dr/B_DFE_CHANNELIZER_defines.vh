`define DFE_CHANNELIZER__CH2_NUM_TAPS_SZ 16

`define DFE_CHANNELIZER__CH3_NUM_TAPS    32'h00000004
`define DFE_CHANNELIZER__CH3_NUM_TAPS_SZ 16

`define DFE_CHANNELIZER__FIR_COEFF_TYPE    32'h00000005
`define DFE_CHANNELIZER__FIR_COEFF_TYPE_SZ 56

`define DFE_CHANNELIZER__MAX_FIR_LENGTH    32'h00000006
`define DFE_CHANNELIZER__MAX_FIR_LENGTH_SZ 16

`define DFE_CHANNELIZER__MODE    32'h00000007
