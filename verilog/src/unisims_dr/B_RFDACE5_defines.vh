// BLH dynamic attribute configuration look-up table addresses
//

`ifdef B_RFDACE5_DEFINES_VH
`else
`define B_RFDACE5_DEFINES_VH

// Look-up table parameters
//

`define RFDACE5_ADDR_N  15
`define RFDACE5_ADDR_SZ 32
`define RFDACE5_DATA_SZ 80

// Attribute addresses
//

`define RFDACE5__MEMORY_INIT_FILE    32'h00000000
`define RFDACE5__MEMORY_INIT_FILE_SZ 32

`define RFDACE5__SIM_DEVICE    32'h00000001
`define RFDACE5__SIM_DEVICE_SZ 80

`define RFDACE5__XPA_ACTIVE_DUTYCYCLE    32'h00000002
`define RFDACE5__XPA_ACTIVE_DUTYCYCLE_SZ 7

`define RFDACE5__XPA_CHANNELIZER_ENABLE    32'h00000003
`define RFDACE5__XPA_CHANNELIZER_ENABLE_SZ 2

`define RFDACE5__XPA_CHANNELS_PER_TILE    32'h00000004
`define RFDACE5__XPA_CHANNELS_PER_TILE_SZ 3

`define RFDACE5__XPA_CLOCK_SOURCE    32'h00000005
`define RFDACE5__XPA_CLOCK_SOURCE_SZ 2

`define RFDACE5__XPA_DATAPATH_MODE    32'h00000006
`define RFDACE5__XPA_DATAPATH_MODE_SZ 2

`define RFDACE5__XPA_INTERPOLATION    32'h00000007
`define RFDACE5__XPA_INTERPOLATION_SZ 4

`define RFDACE5__XPA_MIXING    32'h00000008
`define RFDACE5__XPA_MIXING_SZ 2

`define RFDACE5__XPA_NUMBER_OF_DUC    32'h00000009
`define RFDACE5__XPA_NUMBER_OF_DUC_SZ 4

`define RFDACE5__XPA_PFIR_CHANNELIZER_LOCATION    32'h0000000a
`define RFDACE5__XPA_PFIR_CHANNELIZER_LOCATION_SZ 1

`define RFDACE5__XPA_PFIR_TAPS    32'h0000000b
`define RFDACE5__XPA_PFIR_TAPS_SZ 7

`define RFDACE5__XPA_QMC_TAPS    32'h0000000c
`define RFDACE5__XPA_QMC_TAPS_SZ 7

`define RFDACE5__XPA_SAMPLE_RATE    32'h0000000d
`define RFDACE5__XPA_SAMPLE_RATE_SZ 14

`define RFDACE5__XPA_SPARE    32'h0000000e
`define RFDACE5__XPA_SPARE_SZ 7

`endif  // B_RFDACE5_DEFINES_VH